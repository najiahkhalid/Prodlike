DATABASE_URL=postgresql://prodlike:prodlike@localhost:5432/prodlike?schema=public
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000

# Must match apps/web JWT_ACCESS_SECRET. Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false
AUTH_RATE_LIMIT=10

SCENARIOS_AUTO_PUBLISH=true

# First admin account, created by: pnpm --filter @prodlike/api db:seed
ADMIN_EMAIL=admin@prodlike.local
ADMIN_PASSWORD=change-me-please

{
  "name": "prodlike",
  "private": true,
  "description": "Prodlike: a practical software engineering training simulator (CS344 Web Engineering, NUST SEECS)",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @prodlike/api prisma:generate",
    "db:migrate": "pnpm --filter @prodlike/api prisma:migrate",
    "scenarios:validate": "pnpm --filter @prodlike/shared validate:scenarios",
    "scenarios:build": "node infra/scripts/build-scenarios.mjs",
    "quality:lighthouse": "pnpm dlx @lhci/cli@0.14.0 autorun --config=lighthouserc.json",
    "load:test": "docker run --rm -i -e BASE_URL -e VUS -e PROFILE -e SCENARIO grafana/k6:0.54.0 run - < infra/load/attempts.k6.js"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "eslint": "9.17.0",
    "prettier": "3.4.2",
    "turbo": "2.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.1"
  },
  "pnpm": {
    "overrides": {
      "lodash": "4.18.1",
      "multer@2": "2.5.0",
      "path-to-regexp@0.1": "0.1.13",
      "body-parser@1": "1.20.9",
      "postcss@8": "8.5.18"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mrhx-c7xc-m3w5"
      ]
    }
  }
}

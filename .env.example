# Root env, used by docker compose:  cp .env.example .env
# (For running apps on the host, copy apps/api/.env.example and apps/web/.env.example instead.)
POSTGRES_USER=prodlike
POSTGRES_PASSWORD=prodlike
POSTGRES_DB=prodlike

# Shared by the API (signs) and the web app (verifies) access tokens. Change it for any real use:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-change-me-0123456789abcdef

# First admin account, created when the API container starts
ADMIN_EMAIL=admin@prodlike.local
ADMIN_PASSWORD=change-me-please

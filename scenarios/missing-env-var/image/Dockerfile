# Sandbox image for the missing-env-var scenario. Build context = scenarios/missing-env-var
FROM prodlike/sandbox-base:node20

# Dependencies are installed at image build time: sandboxes run with no network (ADR-005).
COPY --chown=node:node template/package.json /workspace/package.json
RUN npm install --no-audit --no-fund && npm cache clean --force

COPY --chown=node:node template/ /workspace/
# Hidden tests are NOT copied here; the API copies them in only at scoring time.

# Seed a git history so "git log" / "git show" tell the release-train story. Release v3.8.0 had every
# variable; the last commit (ops-bot) drops one. The API folds the attempt's variant of
# deploy/notifications.env into that commit (ADR-010).
RUN cp deploy/notifications.env /tmp/notifications.env \
 && sed -i -e 's|{{PRESENT_LINE}}|SMS_GATEWAY_URL=https://sms.paydost.internal/v2/send\nSMS_API_KEY=pk_live_1b22d0a9c7|' \
           -e 's|regenerated by ops-bot.*|release v3.8.0)|' deploy/notifications.env \
 && git init -q -b main \
 && git add -A \
 && git -c user.name=ci-bot -c user.email=ci@paydost.test commit -qm "release v3.8.0" \
 && git -c user.name=Ayesha -c user.email=ayesha@paydost.test commit -q --allow-empty -m "docs(runbook): list required SMS config" \
 && cp /tmp/notifications.env deploy/notifications.env \
 && git add -A \
 && git -c user.name=ops-bot -c user.email=ops-bot@paydost.test commit -qm "ops: rotate SMS gateway secrets"
